<Project>

  <PropertyGroup Label="Language">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Quality">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- BenchmarkDotNet generates and restores BenchmarkDotNet.Autogenerated.csproj, which imports
         this file. That generated project has no lock file, so with CI=true locked mode would fail
         with NU1004. It is opted out of lock files and locked mode here; all real projects keep them. -->
    <RestorePackagesWithLockFile Condition="'$(MSBuildProjectName)' != 'BenchmarkDotNet.Autogenerated'">true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true' and '$(RestorePackagesWithLockFile)' == 'true'">true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <PropertyGroup Label="CI" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Metadata">
    <Version>3.0.1</Version>
    <Authors>Cristopher Braatz Cardoso</Authors>
    <Copyright>Copyright (c) 2026 Cristopher Braatz Cardoso</Copyright>
    <RepositoryUrl>https://github.com/crisbraatz/metaphone-pt-br</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Label="Non-packable by default">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- BenchmarkDotNet generated project only. The benchmark sources themselves still compile with
       warnings as errors and are audited at low severity in MetaphonePtBr.Benchmarks. Relaxed here so
       a low-severity advisory on a transitive BenchmarkDotNet dependency does not break the generated
       wrapper build, which cannot be changed. -->
  <PropertyGroup Label="BenchmarkDotNet generated project" Condition="'$(MSBuildProjectName)' == 'BenchmarkDotNet.Autogenerated'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
  </PropertyGroup>

</Project>
